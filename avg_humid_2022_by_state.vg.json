{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Radial daily humidity visualization with correct month alignment",
  "width": 50,
  "height": 50,
  "title": "",
  "background":"transparent",
  "signals": [
    {
      "name": "selectedState",
      "value": "Selangor",
      "bind": {
        "input": "select",
        "options": [
          "Selangor", "Johor", "Kedah", "Kelantan", "Melaka", "Pahang",
          "Pulau Pinang", "Perak", "Sabah", "Sarawak", "Terengganu", "Kuala Lumpur"
        ],
        "name": "Select a State: "
      }
    },
    {
      "name": "selectedMonth",
      "value": "Jan"
    }
  ],

  "data": [
    {
      "name": "month_days",
      "values": [
        {"monthNum": 0, "daysInMonth": 31},
        {"monthNum": 1, "daysInMonth": 28},
        {"monthNum": 2, "daysInMonth": 31},
        {"monthNum": 3, "daysInMonth": 30},
        {"monthNum": 4, "daysInMonth": 31},
        {"monthNum": 5, "daysInMonth": 30},
        {"monthNum": 6, "daysInMonth": 31},
        {"monthNum": 7, "daysInMonth": 31},
        {"monthNum": 8, "daysInMonth": 30},
        {"monthNum": 9, "daysInMonth": 31},
        {"monthNum": 10, "daysInMonth": 30},
        {"monthNum": 11, "daysInMonth": 31}
      ]
    },
    {
      "name": "humid",
      "url": "https://raw.githubusercontent.com/Nigel0809/FIT3179/refs/heads/main/weather_summary_by_state_month.csv",
      "format": {"type": "csv"},
      "transform": [
        {"type": "filter", "expr": "datum.state == selectedState"},
        {"type": "formula", "as": "dateObj", "expr": "toDate(datum.date)"},
        {"type": "formula", "as": "monthNum", "expr": "month(datum.dateObj)"},
        {"type": "formula", "as": "dayOfMonth", "expr": "date(datum.dateObj)"},
        {
          "type": "lookup",
          "from": "month_days",
          "key": "monthNum",
          "fields": ["monthNum"],
          "values": ["daysInMonth"]
        },
        {
          "type": "formula",
          "as": "month",
          "expr": "timeFormat(datum.dateObj, '%b')"
        },
        {
          "type": "formula",
          "as": "angle",
          "expr": "(2 * PI * ((datum.monthNum + (datum.dayOfMonth / datum.daysInMonth)) / 12)) - (PI / 2)"
        },
        {"type": "formula", "as": "inner_r", "expr": "80"},
        {"type": "formula", "as": "outer_r", "expr": "datum.inner_r + datum.avg_humidity * 1.5"},
        {"type": "formula", "as": "x1", "expr": "300 + cos(datum.angle) * datum.inner_r"},
        {"type": "formula", "as": "y1", "expr": "300 + sin(datum.angle) * datum.inner_r"},
        {"type": "formula", "as": "x2", "expr": "300 + cos(datum.angle) * datum.outer_r"},
        {"type": "formula", "as": "y2", "expr": "300 + sin(datum.angle) * datum.outer_r"}
      ]
    },
    {
      "name": "month_labels",
      "values": [
        {"month": "Jan", "index": 0},
        {"month": "Feb", "index": 1},
        {"month": "Mar", "index": 2},
        {"month": "Apr", "index": 3},
        {"month": "May", "index": 4},
        {"month": "Jun", "index": 5},
        {"month": "Jul", "index": 6},
        {"month": "Aug", "index": 7},
        {"month": "Sep", "index": 8},
        {"month": "Oct", "index": 9},
        {"month": "Nov", "index": 10},
        {"month": "Dec", "index": 11}
      ],
      "transform": [
        {
          "type": "formula",
          "as": "angle",
          "expr": "(-PI/2) + (datum.index * (2 * PI / 12))"
        },
        {"type": "formula", "as": "x", "expr": "300 + cos(datum.angle) * 250"},
        {"type": "formula", "as": "y", "expr": "300 + sin(datum.angle) * 250"}
      ]
    },
    {
      "name": "month_dividers",
      "values": [
        {"index": 0}, {"index": 1}, {"index": 2}, {"index": 3},
        {"index": 4}, {"index": 5}, {"index": 6}, {"index": 7},
        {"index": 8}, {"index": 9}, {"index": 10}, {"index": 11}
      ],
      "transform": [
        {
          "type": "formula",
          "as": "angle",
          "expr": "(datum.index * (2 * PI / 12)) - (PI / 2)"
        },
        {"type": "formula", "as": "x1", "expr": "300 + cos(datum.angle) * 80"},
        {"type": "formula", "as": "y1", "expr": "300 + sin(datum.angle) * 80"},
        {"type": "formula", "as": "x2", "expr": "300 + cos(datum.angle) * 230"},
        {"type": "formula", "as": "y2", "expr": "300 + sin(datum.angle) * 230"}
      ]
    }
  ],

  "scales": [
    {
      "name": "color",
      "type": "linear",
      "domain": [60, 100],
      "range": ["#DEEBF7", "darkblue"]
    }
  ],

  "marks": [
    {
      "type": "rule",
      "from": {"data": "month_dividers"},
      "encode": {
        "enter": {
          "x": {"field": "x1"},
          "y": {"field": "y1"},
          "x2": {"field": "x2"},
          "y2": {"field": "y2"},
          "stroke": {"value": "black"},
          "strokeWidth": {"value": 1.2},
          "strokeDash": {"value": [7, 3]},
          "opacity": {"value": 1}
        }
      }
    },
    {
      "type": "rule",
      "from": {"data": "humid"},
      "encode": {
        "enter": {
          "x": {"field": "x1"},
          "y": {"field": "y1"},
          "x2": {"field": "x2"},
          "y2": {"field": "y2"},
          "stroke": [
            {
              "test": "datum.month === selectedMonth",
              "scale": "color",
              "field": "avg_humidity"
            },
            {"value": "#CCCCCC"}
          ],
          "strokeWidth": {"value": 2},
          "strokeCap": {"value": "round"},
          "strokeOpacity": [
            {"test": "datum.month === selectedMonth", "value": 0.9},
            {"test": "selectedMonth !== null", "value": 0.2},
            {"value": 0.9}
          ],
          "tooltip": {
            "signal": "{'Date': datum.date, 'Average Humidity (%)': format(datum.avg_humidity, '.2f')}"
          }
        },
        "update": {
          "stroke": [
            {"test": "datum.month === selectedMonth", "scale": "color", "field": "avg_humidity"},
            {"value": "#CCCCCC"}
          ],
          "strokeOpacity": [
            {"test": "datum.month === selectedMonth", "value": 0.9},
            {"test": "selectedMonth !== null", "value": 0.2},
            {"value": 0.9}
          ],
          "opacity": {"value": 0.95}
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "month_labels"},
      "encode": {
        "enter": {
          "x": {"field": "x"},
          "y": {"field": "y"},
          "text": {"field": "month"},
          "fontSize": {"value": 14},
          "fill": [
            {"test": "datum.month === selectedMonth", "value": "darkblue"},
            {"value": "grey"}
          ],
          "align": {"value": "center"},
          "baseline": {"value": "middle"}
        },
        "update": {
          "fill": [
            {"test": "datum.month === selectedMonth", "value": "darkblue"},
            {"value": "grey"}
          ]
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {"value": 300},
          "y": {"value": 300},
          "text": {"signal": "selectedState"},
          "fontSize": {"value": 22},
          "fontWeight": {"value": "bold"},
          "align": {"value": "center"},
          "baseline": {"value": "middle"},
          "fill": {"value": "darkblue"}
        },
        "update": {
          "text": {"signal": "selectedState"}
        }
      }
    }
  ],

  "legends": [
    {
      "fill": "color",
      "title": "Average Humidity (%)",
      "orient": "top-left",
      "titleAlign": "left",
      "padding":5
    }
  ],

  "config": {"background": "white"}
}
