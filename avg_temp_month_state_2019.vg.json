{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 350,
  "title": "Average temperature by month and state (2019)",
  "data": {
    "url": "https://raw.githubusercontent.com/Nigel0809/FIT3179/refs/heads/main/air_pollution_2019_by_state_month.csv"
  },
  "params": [
    {
      "name": "StateSelection",
      "value": "All",
      "bind": {
        "input": "select",
        "options": [
          "All",
          "Johor", "Kedah", "Kelantan", "Kuala Lumpur", "Labuan", "Melaka",
          "Pahang", "Perak", "Pulau Pinang", "Sabah", "Sarawak", "Selangor",
          "Terengganu"
        ],
        "labels": [
          "All States",
          "Johor", "Kedah", "Kelantan", "Kuala Lumpur", "Labuan", "Melaka",
          "Pahang", "Perak", "Pulau Pinang", "Sabah", "Sarawak", "Selangor",
          "Terengganu"
        ],
        "name": "Select a State: "
      }
    }
  ],
  "transform": [
    { "filter": "StateSelection == 'All' || datum.state == StateSelection" }
  ],

  "encoding": {
    "color": {
      "field": "state",
      "type": "nominal",
      "title": "State",
      "scale": {
        "domain": [
          "Johor", "Kedah", "Kelantan", "Kuala Lumpur", "Labuan", "Melaka",
          "Pahang", "Perak", "Pulau Pinang", "Sabah", "Sarawak", "Selangor",
          "Terengganu"
        ],
        "range": [
          "#1f77b4", "#ff7f0e", "#2ca02c", "#d62728", "#9467bd", "#8c564b",
          "#e377c2", "#7f7f7f", "#bcbd22", "#17becf", "#aec7e8", "#ffbb78",
          "#98df8a"
        ]
      }
    }
  },

  "layer": [
    {
      "mark": { "type": "line", "point": true, "strokeWidth": 3 },
      "encoding": {
        "x": {
          "field": "month",
          "type": "ordinal",
          "title": "Month of 2019",
          "sort": [
            "Jan","Feb","Mar","Apr","May","Jun",
            "Jul","Aug","Sep","Oct","Nov","Dec"
          ]
        },
        "y": {
          "field": "avg_temperature",
          "type": "quantitative",
          "title": "Average Temperature (°C)"
        },
        "tooltip": [
          { "field": "state", "title": "State" },
          { "field": "month", "title": "Month" },
          { "field": "avg_temperature", "title": "Avg Temp (°C)", "format": ".2f" }
        ]
      }
    },

    {
      "data": { "values": [{"month": "Mar"}] },
      "mark": {
        "type": "rule",
        "strokeDash": [4, 4],
        "color": "red"
      },
      "encoding": {
        "x": {
          "field": "month",
          "type": "ordinal",
          "sort": [
            "Jan","Feb","Mar","Apr","May","Jun",
            "Jul","Aug","Sep","Oct","Nov","Dec"
          ]
        },
        "color": {"value": "red"}  
      }
    },

    {
      "data": {
        "values": [{"month": "Mar", "label": "Southwest Monsoon Transition"}]
      },
      "mark": {
        "type": "text",
        "color": "red",
        "fontSize": 12,
        "fontStyle": "italic",
        "fontWeight": "bold",
        "align": "left",
        "dx": 8,
        "dy": 120
      },
      "encoding": {
        "x": {
          "field": "month",
          "type": "ordinal",
          "sort": [
            "Jan","Feb","Mar","Apr","May","Jun",
            "Jul","Aug","Sep","Oct","Nov","Dec"
          ]
        },
        "y": { "datum": 33 },
        "text": { "field": "label" },
        "color": {"value": "red"}
      }
    }
  ],

  "config": {
    "axis": { "labelFont": "sans-serif", "titleFont": "sans-serif" },
    "title": { "fontSize": 16, "fontWeight": "bold" }
  }
}
